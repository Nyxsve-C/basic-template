{
  "name": "basic-template",
  "version": "1.0.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nyxsve-C/basic-template.git"
  },
  "license": "ISC",
  "author": "Nyxsve Cárdenas",
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "start": "webpack serve --config webpack.dev.js",
    "build": "webpack --config webpack.prod.js",
    "build:dev": "webpack --config webpack.dev.js",
    "deployment-branch": "git branch gh-pages",
    "deploy": "git checkout gh-pages && git merge main --no-edit && git add dist -f && git commit -m 'Deployment commit' && git subtree push --prefix dist origin gh-pages && git checkout main"
  },
  "devDependencies": {
    "css-loader": "^7.1.4",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
}
